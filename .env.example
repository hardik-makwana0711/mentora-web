# apps/web/.env.example — copy to `.env` (gitignored)

# Backend API base URL (no trailing slash). Requests go directly to this host
# so they appear in the browser Network tab (e.g. http://localhost:4000/api/v1/...).
VITE_API_BASE_URL=http://localhost:4000

# Remote API example:
# VITE_API_BASE_URL=http://34.232.64.6:4001

VITE_APP_ENV=development
VITE_APP_NAME=Mentora
VITE_SOCKET_URL=
VITE_SENTRY_DSN=
